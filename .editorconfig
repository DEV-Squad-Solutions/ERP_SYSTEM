# Top-level EditorConfig for MiniErp solution
root = true

# Default formatting for all files
[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4

# C# source files
[*.cs]
indent_size = 4

# Treat EF Core Migrations and Designer files as generated code
# This dramatically reduces workload for Roslyn Diagnostic Analyzer Runner,
# Semantic Classification, Document Highlights, and Asset Synchronization.
[**/Migrations/**]
generated_code = true
dotnet_analyzer_diagnostic.severity = none

[**/*.Designer.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none
